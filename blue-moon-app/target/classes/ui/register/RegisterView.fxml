<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.bluemoon.ui.register.RegisterController">
   <children>
      <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <Label text="Đăng ký tài khoản" style="-fx-font-size: 24px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="24.0" />
               </font>
            </Label>
            
            <VBox spacing="10.0" style="-fx-padding: 20px; -fx-background-color: #f5f5f5; -fx-background-radius: 10px;">
               <TextField fx:id="usernameField" promptText="Tên đăng nhập *" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               
               <TextField fx:id="emailField" promptText="Email *" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               
               <PasswordField fx:id="passwordField" promptText="Mật khẩu *" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </PasswordField>
               
               <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu *" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </PasswordField>
               
               <TextField fx:id="fullNameField" promptText="Họ và tên *" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               
               <TextField fx:id="phoneField" promptText="Số điện thoại" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               
               <TextArea fx:id="addressField" promptText="Địa chỉ" prefRowCount="3" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextArea>
               
               <HBox spacing="10.0">
                  <Button fx:id="registerButton" text="Đăng ký" onAction="#handleRegister" style="-fx-font-size: 14px; -fx-pref-width: 120px;">
                     <font>
                        <Font name="Arial" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="cancelButton" text="Hủy" onAction="#handleCancel" style="-fx-font-size: 14px; -fx-pref-width: 120px;">
                     <font>
                        <Font name="Arial" size="14.0" />
                     </font>
                  </Button>
               </HBox>
               
               <Label fx:id="errorLabel" text="" style="-fx-text-fill: red; -fx-font-size: 12px;" visible="false">
                  <font>
                     <Font name="Arial" size="12.0" />
                  </font>
               </Label>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

