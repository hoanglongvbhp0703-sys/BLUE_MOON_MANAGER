<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.bluemoon.ui.function.FunctionManagementController">
   <top>
      <HBox spacing="10.0" alignment="CENTER_RIGHT">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="addButton" text="Thêm" onAction="#handleAdd" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
            <Button fx:id="editButton" text="Sửa" onAction="#handleEdit" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
            <Button fx:id="deleteButton" text="Xóa" onAction="#handleDelete" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="functionTable" style="-fx-font-size: 14px;">
         <columns>
            <TableColumn fx:id="sttColumn" text="STT" prefWidth="50.0" />
            <TableColumn fx:id="nameColumn" text="Tên chức năng" prefWidth="250.0" />
            <TableColumn fx:id="functionGroupColumn" text="Nhóm chức năng" prefWidth="150.0" />
            <TableColumn fx:id="boundaryClassColumn" text="Lớp biên" prefWidth="200.0" />
         </columns>
      </TableView>
   </center>
</BorderPane>

