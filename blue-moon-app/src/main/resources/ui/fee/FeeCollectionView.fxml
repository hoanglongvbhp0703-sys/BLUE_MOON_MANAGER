<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.bluemoon.ui.fee.FeeCollectionController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Quản lý thu phí" style="-fx-font-size: 18px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </Label>
            <HBox spacing="10.0">
               <TextField fx:id="searchApartmentCodeField" promptText="Mã căn hộ" prefWidth="120.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchHouseholdCodeField" promptText="Mã hộ dân" prefWidth="120.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchOwnerNameField" promptText="Tên chủ hộ" prefWidth="150.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <ComboBox fx:id="searchMonthCombo" promptText="Tháng" prefWidth="80.0" style="-fx-font-size: 14px;" />
               <ComboBox fx:id="searchYearCombo" promptText="Năm" prefWidth="80.0" style="-fx-font-size: 14px;" />
               <ComboBox fx:id="searchStatusCombo" promptText="Trạng thái" prefWidth="120.0" style="-fx-font-size: 14px;" />
               <Button fx:id="searchButton" text="Tìm kiếm" onAction="#handleSearch" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </Button>
               <Button fx:id="refreshButton" text="Làm mới" onAction="#handleRefresh" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </Button>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="feeTable" style="-fx-font-size: 14px;">
         <columns>
            <TableColumn fx:id="sttColumn" text="STT" prefWidth="50.0" />
            <TableColumn fx:id="apartmentCodeColumn" text="Mã căn hộ" prefWidth="120.0" />
            <TableColumn fx:id="householdCodeColumn" text="Mã hộ dân" prefWidth="120.0" />
            <TableColumn fx:id="ownerNameColumn" text="Tên chủ hộ" prefWidth="200.0" />
            <TableColumn fx:id="monthYearColumn" text="Tháng/Năm" prefWidth="100.0" />
            <TableColumn fx:id="amountColumn" text="Số tiền" prefWidth="150.0" />
            <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120.0" />
            <TableColumn fx:id="paymentDateColumn" text="Ngày thanh toán" prefWidth="120.0" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="20.0" alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="totalLabel" text="Tổng số: 0" style="-fx-font-size: 14px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
            <Label fx:id="paidLabel" text="Đã thu: 0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: green;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
            <Label fx:id="unpaidLabel" text="Chưa thu: 0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
            <Button fx:id="markPaidButton" text="Đánh dấu đã thu phí" onAction="#handleMarkPaid" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>

