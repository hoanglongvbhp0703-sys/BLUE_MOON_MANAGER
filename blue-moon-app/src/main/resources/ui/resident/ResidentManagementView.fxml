<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.bluemoon.ui.resident.ResidentManagementController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Quản lý nhân khẩu" style="-fx-font-size: 18px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </Label>
            <HBox spacing="10.0">
               <TextField fx:id="searchNameField" promptText="Tên nhân khẩu" prefWidth="200.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchApartmentCodeField" promptText="Mã căn hộ" prefWidth="150.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchHouseholdCodeField" promptText="Mã hộ dân" prefWidth="150.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <Button fx:id="searchButton" text="Tìm kiếm" onAction="#handleSearch" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </Button>
               <Button fx:id="refreshButton" text="Làm mới" onAction="#handleRefresh" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </Button>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="residentTable" style="-fx-font-size: 14px;">
         <columns>
            <TableColumn fx:id="sttColumn" text="STT" prefWidth="50.0" />
            <TableColumn fx:id="apartmentCodeColumn" text="Mã căn hộ" prefWidth="120.0" />
            <TableColumn fx:id="householdCodeColumn" text="Mã hộ dân" prefWidth="120.0" />
            <TableColumn fx:id="fullNameColumn" text="Họ và tên" prefWidth="200.0" />
            <TableColumn fx:id="idCardColumn" text="CMND/CCCD" prefWidth="120.0" />
            <TableColumn fx:id="dateOfBirthColumn" text="Ngày sinh" prefWidth="100.0" />
            <TableColumn fx:id="genderColumn" text="Giới tính" prefWidth="80.0" />
            <TableColumn fx:id="relationshipColumn" text="Quan hệ" prefWidth="100.0" />
            <TableColumn fx:id="phoneColumn" text="Số điện thoại" prefWidth="120.0" />
            <TableColumn fx:id="occupationColumn" text="Nghề nghiệp" prefWidth="150.0" />
            <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="100.0" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="totalLabel" text="Tổng số: 0 nhân khẩu" style="-fx-font-size: 14px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>
</BorderPane>

