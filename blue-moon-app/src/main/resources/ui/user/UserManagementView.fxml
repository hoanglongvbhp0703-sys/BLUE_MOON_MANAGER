<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.bluemoon.ui.user.UserManagementController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Tìm kiếm người dùng" style="-fx-font-size: 18px; -fx-font-weight: bold;">
               <font>
                  <Font name="Arial" size="18.0" />
               </font>
            </Label>
            <HBox spacing="10.0">
               <TextField fx:id="searchUsernameField" promptText="Tên đăng nhập" prefWidth="200.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchEmailField" promptText="Email" prefWidth="200.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchFullNameField" promptText="Họ và tên" prefWidth="200.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <TextField fx:id="searchPhoneField" promptText="Số điện thoại" prefWidth="200.0" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </TextField>
               <Button fx:id="searchButton" text="Tìm kiếm" onAction="#handleSearch" style="-fx-font-size: 14px;">
                  <font>
                     <Font name="Arial" size="14.0" />
                  </font>
               </Button>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="userTable" style="-fx-font-size: 14px;">
         <columns>
            <TableColumn fx:id="sttColumn" text="STT" prefWidth="50.0" />
            <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" prefWidth="150.0" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0" />
            <TableColumn fx:id="fullNameColumn" text="Họ và tên" prefWidth="200.0" />
            <TableColumn fx:id="phoneColumn" text="Số điện thoại" prefWidth="150.0" />
            <TableColumn fx:id="isActiveColumn" text="Trạng thái" prefWidth="100.0" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="10.0" alignment="CENTER_RIGHT">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="disableButton" text="Vô hiệu hóa" onAction="#handleDisable" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
            <Button fx:id="enableButton" text="Kích hoạt" onAction="#handleEnable" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
            <Button fx:id="requirePasswordChangeButton" text="Yêu cầu đổi mật khẩu" onAction="#handleRequirePasswordChange" style="-fx-font-size: 14px;">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>

